# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
*.log
.DS_Store

# Build artefacts that shouldn't land
npm/platform/*/bin/agent-qa-*
!npm/platform/*/bin/.gitkeep
# Mirrored from repo root by scripts/build-umbrella-pkg.js at release time.
npm/agent-qa/skills/

# Editor
.vscode/
.idea/
*.swp

# Runtime scenario / record output
tmp/

# Runtime replay output — scenarios write run dirs under <sid>/replays/
npm/agent-qa/replays/
**/replays/

# Built web bundle — generated by `npm run build:web`, never committed
npm/agent-qa/lib/public/
