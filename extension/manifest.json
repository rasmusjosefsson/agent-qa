{
  "manifest_version": 3,
  "name": "agent-qa recorder",
  "version": "0.1.0",
  "description": "One-click capture of a web flow + its network traffic, exported as an agent-qa replay bundle.",
  "permissions": ["downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "agent-qa recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
