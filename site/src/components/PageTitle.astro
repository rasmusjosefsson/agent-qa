---
import Default from "@astrojs/starlight/components/PageTitle.astro"

const icons = import.meta.glob<string>("../assets/icons/*.svg", { query: "?raw", import: "default", eager: true })
const icon = (name: string) => icons[`../assets/icons/${name}.svg`]

// Docs slug → page icon from src/assets/icons/.
const PAGE_ICONS: Record<string, string> = {
  "docs/quickstart": "cursor-check",
  "docs/overview": "replay-loop",
  "docs/configuration": "code-play",
  "docs/plugins": "code-play",
  "docs/templates": "step-trace",
  "docs/visual-testing": "diff-frames",
  "docs/network": "inspect-q",
  "docs/extension": "viewfinder",
  "docs/github-action": "step-trace",
  "docs/verbs": "code-play",
  "docs/lint-rules": "inspect-q",
  "docs/architecture": "step-trace",
  "docs/releasing": "code-play",
}
const name = PAGE_ICONS[Astro.locals.starlightRoute.id]
const dark = name ? icon(name) : undefined
const light = name ? icon(`${name}-light`) : undefined
// Frontmatter `description` doubles as the visible subtitle under the
// title, so page titles stay on one line.
const subtitle = Astro.locals.starlightRoute.entry.data.description
---

<div class="aqa-page-title">
  {
    dark && (
      <span class="aqa-page-icon" aria-hidden="true"><span class="aqa-dark-only" set:html={dark} /><span class="aqa-light-only" set:html={light} /></span>
    )
  }
  <div class="aqa-page-title-text">
    <Default />
    {subtitle && <p class="aqa-page-subtitle">{subtitle}</p>}
  </div>
</div>

<style>
  .aqa-page-title {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1rem;
  }
  .aqa-page-title :global(h1) {
    margin-top: 0;
  }
  .aqa-page-subtitle {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-lg);
    line-height: 1.45;
    color: var(--aqa-muted-fg);
  }
  .aqa-page-icon {
    flex: none;
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    filter: drop-shadow(0 6px 16px color-mix(in oklab, var(--aqa-brand) 35%, transparent));
  }
  .aqa-page-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
