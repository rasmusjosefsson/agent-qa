---
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "../styles/tokens.css"
import "../styles/diagrams.css"
import { loop as loopDiagram } from "../../scripts/diagrams.mjs"
import logo from "../assets/logo.svg?raw"
import { siClaude, siCursor, siGithubcopilot, siGooglegemini, siOpencode, siPi, siWindsurf } from "simple-icons"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const to = (path: string) => `${base}/${path}`
const repo = "https://github.com/rasmusjosefsson/agent-qa"
const install = "npm i -g @rasmusjosefsson/agent-qa"

// Marks from Simple Icons (CC0). Codex and Goose have no entry there, so
// they get an initial tile instead.
const agents: { name: string; path?: string }[] = [
  { name: "Claude Code", path: siClaude.path },
  { name: "Codex" },
  { name: "Cursor", path: siCursor.path },
  { name: "Gemini CLI", path: siGooglegemini.path },
  { name: "GitHub Copilot", path: siGithubcopilot.path },
  { name: "Goose" },
  { name: "OpenCode", path: siOpencode.path },
  { name: "Windsurf", path: siWindsurf.path },
  { name: "Pi", path: siPi.path },
]

const loop = [
  { n: "01", title: "Record", body: "Drive the page yourself or let an agent do it. Each step is observed on the settled page and written with its evidence." },
  { n: "02", title: "Replay", body: "The sealed scenario.json runs deterministically, as one profile per run. No LLM in the loop." },
  { n: "03", title: "Compare", body: "Diff a recording against a replay, or one profile against another. ARIA text diffs, pixel diffs, JSON deltas." },
  { n: "04", title: "Heal", body: "When a step breaks, a bounded patch with a diagnosis goes on the audit trail. Assertions are never healed away." },
]

const steps = [
  { id: "s0", verb: "goto", target: "https://example.com/users", status: "pass", ms: 412 },
  { id: "s1", verb: "fill", target: 'textbox "Email"', status: "pass", ms: 96 },
  { id: "s2", verb: "click", target: 'button "Save"', status: "pass", ms: 184 },
  { id: "s3", verb: "check", target: "network POST /users → 201", status: "pass", ms: 22 },
  { id: "s4", verb: "shot", target: "baselines/s4.png", status: "diff", ms: 310 },
]

const tree = [
  ["scenario.json", "the sealed contract"],
  ["snapshots/", "ARIA tree, one per step"],
  ["screenshots/", "PNG, one per step"],
  ["probes/", "alerts, toasts, aria-invalid"],
  ["network/", "request + response bodies"],
  ["replays/", "one folder per run"],
  ["compare/", "compare.md + JSON deltas"],
]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>agent-qa: record, replay, diff</title>
    <meta name="description" content="Record a user scenario in a real browser. Replay it later. See exactly what changed." />
    <link rel="icon" href={to("favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      // Same key Starlight uses, so the toggle carries into the docs.
      try {
        const t = localStorage.getItem("starlight-theme")
        const theme = t === "light" || t === "dark" ? t : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"
        document.documentElement.dataset.theme = theme
      } catch {}
    </script>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={to("")}>
          <span class="brand-mark" set:html={logo} />
          agent-qa
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={to("docs/quickstart/")}>Quickstart</a>
          <a href={to("docs/overview/")}>Docs</a>
          <a href={to("docs/verbs/")}>Reference</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <a class="icon-btn" href={repo} aria-label="agent-qa on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg>
          </a>
          <a class="btn btn-primary btn-sm" href={to("docs/quickstart/")}>Get started</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero wrap">
        <div class="hero-copy">
          <a class="pill" href={repo}>
            <span class="pill-dot"></span>
            Open source · MIT · Rust CLI
          </a>
          <h1>
            Record a flow once.
            <span class="gradient-text">Replay it on every change.</span>
          </h1>
          <p class="lede">
            agent-qa records a user scenario in a real browser, replays it later, and shows you exactly what
            changed. Every result comes with the snapshots, screenshots, and network traffic behind it.
          </p>
          <div class="cta-row">
            <div class="install" data-copy={install}>
              <span class="prompt">$</span>
              <code>{install}</code>
              <button type="button" class="copy" aria-label="Copy install command">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="copied">Copied</span>
              </button>
            </div>
            <a class="btn btn-ghost" href={to("docs/overview/")}>
              How it works
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Example replay of a recorded scenario">
          <div class="window">
            <div class="window-bar">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="window-title">replay · create-user · run 3</span>
              <span class="badge badge-warn">1 visual diff</span>
            </div>
            <ol class="steps">
              {
                steps.map((s, i) => (
                  <li class="step" style={`--i:${i}`}>
                    <span class={`status status-${s.status}`} aria-label={s.status}>
                      {s.status === "pass" ? (
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                      ) : (
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 7v6M12 17h.01"/></svg>
                      )}
                    </span>
                    <span class="step-id">{s.id}</span>
                    <span class="verb">{s.verb}</span>
                    <span class="target">{s.target}</span>
                    <span class="ms">{s.ms}ms</span>
                  </li>
                ))
              }
            </ol>
            <div class="diff-strip">
              <div class="shot">
                <span class="shot-label">baseline</span>
                <div class="mock"><i></i><i></i><b></b></div>
              </div>
              <div class="shot">
                <span class="shot-label">run 3</span>
                <div class="mock mock-moved"><i></i><i></i><b></b></div>
              </div>
              <div class="shot">
                <span class="shot-label">delta</span>
                <div class="mock mock-delta"><b></b></div>
              </div>
            </div>
          </div>
          <div class="float-card">
            <span class="float-k">compare.md</span>
            <span class="float-v">4 steps identical · <em>s4</em> moved 12px</span>
          </div>
        </div>
      </section>

      <section class="agents wrap" aria-label="Works with your coding agent">
        <p>Your coding agent already knows how to use it. The discovery stub works with</p>
        <ul>
          {
            agents.map((a) => (
              <li>
                {a.path ? (
                  <svg class="agent-mark" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={a.path} />
                  </svg>
                ) : (
                  <span class="agent-mark agent-initial" aria-hidden="true">
                    {a.name[0]}
                  </span>
                )}
                {a.name}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section wrap" id="loop">
        <div class="section-head">
          <span class="eyebrow">The loop</span>
          <h2>A green test and a working flow are different things.</h2>
          <p>
            A button moves, a modal hides behind a flag, the server returns the wrong shape. A test that only
            checks for a 200 misses all of it. agent-qa gives you the diff instead of a pass/fail bit.
          </p>
        </div>
        <div class="reveal" set:html={loopDiagram()} />
        <ol class="loop">
          {
            loop.map((l) => (
              <li class="loop-card reveal">
                <span class="loop-n">{l.n}</span>
                <h3>{l.title}</h3>
                <p>{l.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="section wrap" id="features">
        <div class="section-head">
          <span class="eyebrow">What you get</span>
          <h2>Every claim has an artifact behind it.</h2>
          <p>"It passed" without files is not a result. Everything agent-qa decides, it writes to disk first.</p>
        </div>

        <div class="bento">
          <article class="card span-2 reveal">
            <div class="card-copy">
              <h3>Evidence on disk</h3>
              <p>
                One folder per scenario, readable by people, agents, and CI. Nothing lives in a dashboard you
                can't grep.
              </p>
            </div>
            <ul class="tree">
              <li class="tree-root">tmp/agent-qa-scenarios/&lt;sid&gt;/</li>
              {
                tree.map(([name, note]) => (
                  <li>
                    <span class="tree-name">{name}</span>
                    <span class="tree-note">{note}</span>
                  </li>
                ))
              }
            </ul>
          </article>

          <article class="card reveal">
            <div class="card-copy">
              <h3>Targets users can see</h3>
              <p>Steps point at roles, accessible names, labels, and URL patterns. Class names aren't targets.</p>
            </div>
            <pre class="snippet"><code><span class="k">"verb"</span>: <span class="s">"click"</span>,
<span class="k">"target"</span>: {"{"}
  <span class="k">"role"</span>: <span class="s">"button"</span>,
  <span class="k">"name"</span>: <span class="s">"Save"</span>
{"}"}</code></pre>
          </article>

          <article class="card reveal">
            <div class="card-copy">
              <h3>Golden screenshots</h3>
              <p>
                Shot claims pixel-diff each run against a checked-in baseline. A miss writes a red delta map.
                Re-mint with one flag.
              </p>
            </div>
            <pre class="snippet"><code><span class="c">$</span> agent-qa shot-accept &lt;sid&gt;
<span class="c">$</span> agent-qa replay &lt;sid&gt; \
    --update-baselines</code></pre>
          </article>

          <article class="card reveal">
            <div class="card-copy">
              <h3>Network and console claims</h3>
              <p>
                Assert on the request behind the UI. A form that renders but never fires its POST, or gets a 500
                back, fails.
              </p>
            </div>
            <div class="net">
              <div class="net-row"><span class="m">POST</span><span class="p">/users</span><span class="ok">201</span></div>
              <div class="net-row"><span class="m">GET</span><span class="p">/users?page=1</span><span class="ok">200</span></div>
              <div class="net-row"><span class="m">console</span><span class="p">0 errors</span><span class="ok">✓</span></div>
            </div>
          </article>

          <article class="card reveal">
            <div class="card-copy">
              <h3>Bug reports you can replay</h3>
              <p>
                The Chrome recorder captures a flow and its traffic as one file. Ingest it, then replay offline
                against the exact responses their browser saw.
              </p>
            </div>
            <pre class="snippet"><code><span class="c">$</span> agent-qa ingest capture.json
<span class="c">$</span> agent-qa replay &lt;sid&gt; \
    --mock-from recorded --offline</code></pre>
          </article>

          <article class="card span-2 reveal">
            <div class="card-copy">
              <h3>Plugins in any language</h3>
              <p>
                Auth, session policy, and setup hooks are subprocesses that speak JSON over stdio. The core stays
                vendor-neutral. The reference plugin is ten lines of POSIX shell.
              </p>
            </div>
            <pre class="snippet"><code><span class="c"># agent-qa.toml</span>
<span class="k">[plugins]</span>
auth = <span class="s">"./plugins/acme-auth/agent-qa-plugin-acme-auth"</span>

<span class="c">$</span> agent-qa plugins doctor</code></pre>
          </article>


          <article class="card reveal">
            <div class="card-copy">
              <h3>Gate every pull request</h3>
              <p>
                The repo doubles as a composite GitHub Action. Each PR replays the suite headlessly and uploads the
                evidence.
              </p>
            </div>
            <pre class="snippet"><code>- <span class="k">uses</span>: <span class="s">rasmusjosefsson/agent-qa@main</span>
  <span class="k">with</span>:
    <span class="k">scenarios</span>: scenarios
    <span class="k">args</span>: --retry 2 --junit</code></pre>
          </article>

          <article class="card span-3 workbench reveal">
            <div class="card-copy">
              <h3>A workbench when you want one</h3>
              <p>
                <code>agent-qa serve</code> opens a local UI. Write cases in plain English, group them into sets,
                run a plan, and step through each replay.
              </p>
            </div>
            <ol class="flow">
              <li><span>1</span><div><b>Cases</b><small>Write a test in plain English</small></div></li>
              <li><span>2</span><div><b>Sets</b><small>Group cases you run together</small></div></li>
              <li><span>3</span><div><b>Plans</b><small>Pick a scope and run it</small></div></li>
              <li class="flow-active"><span>4</span><div><b>Runs</b><small>Replay, inspect and compare</small></div></li>
            </ol>
          </article>
        </div>
      </section>

      <section class="section wrap" id="architecture">
        <div class="section-head">
          <span class="eyebrow">How it fits</span>
          <h2>Two layers, one boundary.</h2>
          <p>
            <code>agent-browser</code> drives Chromium over CDP. <code>agent-qa</code> does the bookkeeping:
            profiles, sidecars, replay, compare, heal. It never reimplements what the browser layer already does.
          </p>
        </div>
        <div class="arch reveal">
          <div class="arch-node">
            <small>you or your agent</small>
            <b>Claude Code, Codex, a human…</b>
          </div>
          <span class="arch-edge" aria-hidden="true"></span>
          <div class="arch-node arch-core">
            <small>Rust binary</small>
            <b>agent-qa</b>
            <div class="arch-side">
              <span>plugins · JSON over stdio</span>
              <span>evidence · on disk</span>
            </div>
          </div>
          <span class="arch-edge" aria-hidden="true"></span>
          <div class="arch-node">
            <small>CDP driver</small>
            <b>agent-browser</b>
          </div>
          <span class="arch-edge" aria-hidden="true"></span>
          <div class="arch-node">
            <small>any web app</small>
            <b>Chromium tab</b>
          </div>
        </div>
      </section>

      <section class="final wrap">
        <div class="final-card">
          <h2>Record your first scenario in five minutes.</h2>
          <p>Install the CLI, point it at a page, and replay what you did.</p>
          <div class="cta-row cta-center">
            <div class="install" data-copy={install}>
              <span class="prompt">$</span>
              <code>{install}</code>
              <button type="button" class="copy" aria-label="Copy install command">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="copied">Copied</span>
              </button>
            </div>
            <a class="btn btn-primary" href={to("docs/quickstart/")}>Read the quickstart</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <a class="brand" href={to("")}>
          <span class="brand-mark" set:html={logo} />
          agent-qa
        </a>
        <nav aria-label="Footer">
          <a href={to("docs/quickstart/")}>Quickstart</a>
          <a href={to("docs/overview/")}>How it works</a>
          <a href={to("docs/plugins/")}>Plugins</a>
          <a href={to("docs/verbs/")}>Verbs</a>
          <a href={repo}>GitHub</a>
        </nav>
        <small>MIT licensed</small>
      </div>
    </footer>

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light"
        document.documentElement.dataset.theme = next
        try {
          localStorage.setItem("starlight-theme", next)
        } catch {}
      })

      for (const box of document.querySelectorAll<HTMLElement>(".install")) {
        box.querySelector("button")?.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(box.dataset.copy ?? "")
            box.classList.add("is-copied")
            setTimeout(() => box.classList.remove("is-copied"), 1400)
          } catch {}
        })
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--aqa-bg);
    color: var(--aqa-fg);
    font-family: var(--aqa-font-sans);
    font-feature-settings: "cv11", "ss01";
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--aqa-bg);
    overflow-x: hidden;
  }
  ::selection {
    background: color-mix(in oklab, var(--aqa-brand) 28%, transparent);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  :focus-visible {
    outline: 2px solid var(--aqa-brand);
    outline-offset: 2px;
    border-radius: 6px;
  }
  code,
  pre {
    font-family: var(--aqa-font-mono);
  }
  h1,
  h2,
  h3 {
    margin: 0;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  p {
    margin: 0;
    text-wrap: pretty;
  }
</style>

<style>
  .wrap {
    width: min(1160px, 100% - 32px);
    margin-inline: auto;
  }

  /* Aurora wash + dot grid behind the hero. */
  .backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: 900px;
    pointer-events: none;
    background:
      radial-gradient(45% 55% at 78% 8%, color-mix(in oklab, var(--aqa-brand) 26%, transparent), transparent 70%),
      radial-gradient(30% 40% at 95% 30%, color-mix(in oklab, var(--aqa-brand-3) 16%, transparent), transparent 70%),
      radial-gradient(35% 45% at 8% 0%, color-mix(in oklab, var(--aqa-brand-2) 14%, transparent), transparent 70%);
  }
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, var(--aqa-fg) 10%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 60% at 60% 20%, black, transparent 75%);
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: saturate(1.4) blur(14px);
    background: color-mix(in oklab, var(--aqa-bg) 72%, transparent);
    border-bottom: 1px solid var(--aqa-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: 17px;
  }
  .brand-mark {
    display: inline-grid;
    width: 26px;
    height: 26px;
    filter: drop-shadow(0 4px 12px color-mix(in oklab, var(--aqa-brand) 45%, transparent));
  }
  .brand-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    font-size: 14px;
    color: var(--aqa-muted-fg);
  }
  .nav-links a {
    padding: 6px 10px;
    border-radius: 8px;
    transition: color 140ms, background-color 140ms;
  }
  .nav-links a:hover {
    color: var(--aqa-fg);
    background: var(--aqa-muted);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    border: 0;
    background: transparent;
    color: var(--aqa-muted-fg);
    cursor: pointer;
    transition: color 140ms, background-color 140ms;
  }
  .icon-btn:hover {
    color: var(--aqa-fg);
    background: var(--aqa-muted);
  }
  :global([data-theme="dark"]) .sun,
  :global([data-theme="light"]) .moon {
    display: none;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: 11px;
    font-size: 15px;
    font-weight: 550;
    white-space: nowrap;
    transition: transform 160ms, box-shadow 160ms, background-color 160ms, border-color 160ms;
  }
  .btn-sm {
    height: 34px;
    padding: 0 14px;
    font-size: 14px;
    border-radius: 9px;
  }
  .btn-primary {
    color: white;
    background: linear-gradient(135deg, var(--aqa-brand), color-mix(in oklab, var(--aqa-brand) 55%, var(--aqa-brand-3)));
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 20%) inset,
      0 6px 20px -6px color-mix(in oklab, var(--aqa-brand) 70%, transparent);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 20%) inset,
      0 10px 28px -8px color-mix(in oklab, var(--aqa-brand) 80%, transparent);
  }
  .btn-ghost {
    border: 1px solid var(--aqa-border-strong);
    background: color-mix(in oklab, var(--aqa-card) 50%, transparent);
  }
  .btn-ghost:hover {
    border-color: color-mix(in oklab, var(--aqa-brand) 50%, var(--aqa-border-strong));
    background: var(--aqa-card);
  }
  .btn-ghost svg {
    transition: transform 160ms;
  }
  .btn-ghost:hover svg {
    transform: translateX(2px);
  }

  /* Hero */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 88px 0 72px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--aqa-border-strong);
    background: color-mix(in oklab, var(--aqa-card) 60%, transparent);
    font-size: 13px;
    color: var(--aqa-muted-fg);
    transition: border-color 160ms, color 160ms;
  }
  .pill:hover {
    color: var(--aqa-fg);
    border-color: color-mix(in oklab, var(--aqa-brand) 50%, transparent);
  }
  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--aqa-success);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--aqa-success) 25%, transparent);
  }
  .hero h1 {
    margin-top: 22px;
    font-size: clamp(40px, 5.2vw, 62px);
    line-height: 1.02;
    font-weight: 700;
  }
  .gradient-text {
    display: block;
    background-image: linear-gradient(100deg, var(--aqa-brand-2) 0%, var(--aqa-brand) 45%, var(--aqa-brand-3) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .lede {
    margin-top: 22px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 1.6;
    color: var(--aqa-muted-fg);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .cta-center {
    justify-content: center;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 6px 0 16px;
    border-radius: 11px;
    border: 1px solid var(--aqa-border-strong);
    background: color-mix(in oklab, var(--aqa-card) 85%, transparent);
    font-size: 14px;
    max-width: 100%;
  }
  .install code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .prompt {
    color: var(--aqa-brand);
    font-family: var(--aqa-font-mono);
  }
  .copy {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--aqa-muted-fg);
    cursor: pointer;
  }
  .copy:hover {
    background: var(--aqa-muted);
    color: var(--aqa-fg);
  }
  .copied {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--aqa-fg);
    color: var(--aqa-bg);
    font: 500 12px var(--aqa-font-sans);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms, translate 160ms;
  }
  .is-copied .copied {
    opacity: 1;
    translate: -50% 0;
  }

  /* Hero visual: an illustrative replay window. */
  .hero-visual {
    position: relative;
  }
  .window {
    position: relative;
    border-radius: 16px;
    border: 1px solid var(--aqa-border-strong);
    background: color-mix(in oklab, var(--aqa-card) 92%, transparent);
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 6%) inset,
      0 30px 80px -20px hsl(var(--aqa-shadow) / 0.55),
      0 0 0 1px color-mix(in oklab, var(--aqa-brand) 10%, transparent);
    overflow: hidden;
  }
  .window::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(140deg, color-mix(in oklab, var(--aqa-brand) 70%, transparent), transparent 35%, transparent 70%, color-mix(in oklab, var(--aqa-brand-3) 50%, transparent));
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--aqa-border);
    font-size: 12.5px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 99px;
    background: var(--aqa-border-strong);
  }
  .window-title {
    font-family: var(--aqa-font-mono);
    color: var(--aqa-muted-fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .badge {
    margin-left: auto;
    flex: none;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 11.5px;
    font-weight: 600;
  }
  .badge-warn {
    color: var(--aqa-warning);
    background: color-mix(in oklab, var(--aqa-warning) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--aqa-warning) 30%, transparent);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 8px;
  }
  .step {
    display: grid;
    grid-template-columns: 20px 24px 50px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 9px;
    font-size: 13px;
    animation: step-in 480ms cubic-bezier(0.21, 1.02, 0.73, 1) both;
    animation-delay: calc(var(--i) * 110ms + 200ms);
  }
  .step:hover {
    background: var(--aqa-muted);
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .status {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 99px;
  }
  .status-pass {
    color: var(--aqa-success);
    background: color-mix(in oklab, var(--aqa-success) 16%, transparent);
  }
  .status-diff {
    color: var(--aqa-warning);
    background: color-mix(in oklab, var(--aqa-warning) 18%, transparent);
  }
  .step-id,
  .ms {
    font-family: var(--aqa-font-mono);
    font-size: 12px;
    color: var(--aqa-muted-fg);
    font-variant-numeric: tabular-nums;
  }
  .verb {
    justify-self: start;
    padding: 1px 7px;
    border-radius: 6px;
    font-family: var(--aqa-font-mono);
    font-size: 11.5px;
    color: color-mix(in oklab, var(--aqa-brand) 70%, var(--aqa-fg));
    background: color-mix(in oklab, var(--aqa-brand) 13%, transparent);
  }
  .target {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--aqa-font-mono);
    font-size: 12.5px;
  }
  .diff-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 4px 16px 16px;
  }
  .shot-label {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--aqa-muted-fg);
  }
  .mock {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    border: 1px solid var(--aqa-border);
    background: var(--aqa-bg);
    padding: 10%;
    display: flex;
    flex-direction: column;
    gap: 9%;
  }
  .mock i {
    display: block;
    height: 14%;
    border-radius: 3px;
    background: var(--aqa-muted);
  }
  .mock i:nth-child(2) {
    width: 70%;
  }
  .mock b {
    display: block;
    width: 38%;
    height: 18%;
    border-radius: 4px;
    background: var(--aqa-brand);
    margin-top: auto;
  }
  .mock-moved b {
    transform: translate(28%, -30%);
  }
  .mock-delta {
    background: color-mix(in oklab, var(--aqa-bg) 80%, black);
  }
  .mock-delta b {
    position: absolute;
    left: 10%;
    bottom: 10%;
    width: 50%;
    height: 34%;
    background: color-mix(in oklab, var(--aqa-destructive) 75%, transparent);
    box-shadow: 0 0 18px color-mix(in oklab, var(--aqa-destructive) 60%, transparent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.55;
    }
  }
  .float-card {
    position: absolute;
    left: -28px;
    bottom: -44px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--aqa-border-strong);
    background: color-mix(in oklab, var(--aqa-card) 88%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px -16px hsl(var(--aqa-shadow) / 0.6);
    font-size: 13px;
    animation: step-in 600ms 900ms both;
  }
  .float-k {
    font-family: var(--aqa-font-mono);
    font-size: 11.5px;
    color: var(--aqa-muted-fg);
  }
  .float-v em {
    font-style: normal;
    color: var(--aqa-warning);
    font-family: var(--aqa-font-mono);
  }

  /* Agents strip */
  .agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 40px 0 24px;
    text-align: center;
  }
  .agents p {
    font-size: 14px;
    color: var(--aqa-muted-fg);
  }
  .agents ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .agents li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 10px;
    border-radius: 99px;
    border: 1px solid var(--aqa-border);
    background: color-mix(in oklab, var(--aqa-card) 50%, transparent);
    font-size: 13.5px;
    font-weight: 500;
    color: color-mix(in oklab, var(--aqa-fg) 72%, var(--aqa-muted-fg));
    transition: color 160ms, border-color 160ms, background-color 160ms;
  }
  .agents li:hover {
    color: var(--aqa-fg);
    border-color: var(--aqa-border-strong);
    background: var(--aqa-card);
  }
  .agent-mark {
    width: 16px;
    height: 16px;
    flex: none;
    fill: currentColor;
  }
  .agent-initial {
    display: grid;
    place-items: center;
    border-radius: 4px;
    border: 1.5px solid currentColor;
    font: 700 9.5px/1 var(--aqa-font-sans);
  }

  /* Sections */
  .section {
    padding: 96px 0 0;
  }
  .section-head {
    max-width: 44rem;
    margin-bottom: 40px;
  }
  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background-image: linear-gradient(90deg, var(--aqa-brand-2), var(--aqa-brand));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .section-head h2 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.08;
    font-weight: 680;
  }
  .section-head p {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--aqa-muted-fg);
  }
  .section-head code,
  .card p code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: color-mix(in oklab, var(--aqa-brand) 12%, transparent);
    color: var(--aqa-fg);
  }

  /* Loop */
  .loop {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: loop;
  }
  .loop-card {
    position: relative;
    padding: 24px;
    border-radius: 16px;
    border: 1px solid var(--aqa-border);
    background: linear-gradient(180deg, color-mix(in oklab, var(--aqa-card) 90%, transparent), color-mix(in oklab, var(--aqa-card) 40%, transparent));
  }
  .loop-card:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 38px;
    right: -15px;
    width: 16px;
    height: 1px;
    background: linear-gradient(90deg, var(--aqa-brand), transparent);
  }
  .loop-n {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    font: 600 12px var(--aqa-font-mono);
    color: white;
    background: linear-gradient(135deg, var(--aqa-brand), color-mix(in oklab, var(--aqa-brand) 55%, var(--aqa-brand-3)));
    box-shadow: 0 6px 18px -6px color-mix(in oklab, var(--aqa-brand) 70%, transparent);
  }
  .loop-card h3 {
    margin-top: 18px;
    font-size: 19px;
    font-weight: 620;
  }
  .loop-card p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--aqa-muted-fg);
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border-radius: 18px;
    border: 1px solid var(--aqa-border);
    background: color-mix(in oklab, var(--aqa-card) 75%, transparent);
    transition: border-color 200ms, transform 200ms, box-shadow 200ms;
  }
  .card:hover {
    border-color: color-mix(in oklab, var(--aqa-brand) 35%, var(--aqa-border));
    box-shadow: 0 20px 50px -30px color-mix(in oklab, var(--aqa-brand) 70%, transparent);
  }
  .span-2 {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
  }
  .span-3 {
    grid-column: span 3;
  }
  .card h3 {
    font-size: 18px;
    font-weight: 620;
  }
  .card p {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--aqa-muted-fg);
  }
  .snippet {
    margin: auto 0 0;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--aqa-border);
    background: var(--aqa-bg-deep);
    font-size: 12.5px;
    line-height: 1.7;
    overflow-x: auto;
  }
  .span-2 .snippet {
    margin: 0;
  }
  .snippet .k {
    color: color-mix(in oklab, var(--aqa-brand) 75%, var(--aqa-fg));
  }
  .snippet .s {
    color: var(--aqa-success);
  }
  .snippet .c {
    color: var(--aqa-muted-fg);
  }
  .tree {
    margin: 0;
    padding: 14px 16px;
    list-style: none;
    border-radius: 12px;
    border: 1px solid var(--aqa-border);
    background: var(--aqa-bg-deep);
    font: 12.5px/1.9 var(--aqa-font-mono);
  }
  .tree li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-left: 16px;
  }
  .tree li.tree-root {
    padding-left: 0;
    color: var(--aqa-muted-fg);
  }
  .tree-name {
    color: color-mix(in oklab, var(--aqa-brand-2) 70%, var(--aqa-fg));
  }
  .tree-note {
    color: var(--aqa-muted-fg);
    text-align: right;
    font-family: var(--aqa-font-sans);
    font-size: 12.5px;
  }
  .net {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: auto;
  }
  .net-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--aqa-border);
    background: var(--aqa-bg-deep);
    font: 12.5px var(--aqa-font-mono);
  }
  .net-row .m {
    color: var(--aqa-muted-fg);
  }
  .net-row .ok {
    color: var(--aqa-success);
  }
  .workbench {
    flex-direction: row;
    align-items: center;
    gap: 32px;
    background:
      radial-gradient(60% 120% at 100% 0%, color-mix(in oklab, var(--aqa-brand) 14%, transparent), transparent 70%),
      color-mix(in oklab, var(--aqa-card) 75%, transparent);
  }
  .workbench .card-copy {
    flex: 0 1 22rem;
  }
  .flow {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--aqa-border);
    background: var(--aqa-bg-deep);
  }
  .flow span {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    color: var(--aqa-muted-fg);
    background: var(--aqa-muted);
  }
  .flow b {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
  }
  .flow small {
    display: block;
    font-size: 12px;
    color: var(--aqa-muted-fg);
  }
  .flow-active {
    border-color: color-mix(in oklab, var(--aqa-brand) 40%, transparent) !important;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--aqa-brand) 14%, transparent);
  }
  .flow-active span {
    color: white;
    background: linear-gradient(135deg, var(--aqa-brand), color-mix(in oklab, var(--aqa-brand) 55%, var(--aqa-brand-3)));
  }

  /* Architecture */
  .arch {
    display: flex;
    align-items: stretch;
    gap: 0;
  }
  .arch-node {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 20px;
    border-radius: 16px;
    border: 1px solid var(--aqa-border);
    background: color-mix(in oklab, var(--aqa-card) 70%, transparent);
  }
  .arch-node small {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--aqa-muted-fg);
  }
  .arch-node b {
    font-size: 16px;
    font-weight: 620;
  }
  .arch-core {
    flex: 1.4;
    border-color: color-mix(in oklab, var(--aqa-brand) 45%, transparent);
    background:
      radial-gradient(80% 120% at 50% 0%, color-mix(in oklab, var(--aqa-brand) 20%, transparent), transparent 80%),
      var(--aqa-card);
    box-shadow: 0 20px 60px -30px color-mix(in oklab, var(--aqa-brand) 90%, transparent);
  }
  .arch-core b {
    font-family: var(--aqa-font-mono);
    font-size: 20px;
  }
  .arch-side {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .arch-side span {
    padding: 3px 9px;
    border-radius: 99px;
    font-size: 12px;
    border: 1px solid var(--aqa-border-strong);
    color: var(--aqa-muted-fg);
  }
  .arch-edge {
    flex: 0 0 36px;
    align-self: center;
    height: 2px;
    background: linear-gradient(90deg, var(--aqa-border-strong), var(--aqa-brand), var(--aqa-border-strong));
    background-size: 200% 100%;
    animation: flowline 2.4s linear infinite;
  }
  @keyframes flowline {
    to {
      background-position: -200% 0;
    }
  }

  /* Final CTA */
  .final {
    padding: 112px 0 96px;
  }
  .final-card {
    position: relative;
    overflow: hidden;
    padding: 64px 32px;
    border-radius: 24px;
    border: 1px solid color-mix(in oklab, var(--aqa-brand) 30%, var(--aqa-border));
    text-align: center;
    background:
      radial-gradient(50% 80% at 50% 0%, color-mix(in oklab, var(--aqa-brand) 28%, transparent), transparent 75%),
      radial-gradient(40% 60% at 90% 100%, color-mix(in oklab, var(--aqa-brand-3) 16%, transparent), transparent 75%),
