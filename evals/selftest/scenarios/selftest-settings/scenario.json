{
  "schema": "scenario/2",
  "id": "selftest-settings",
  "intent": "Workbench settings renders",
  "env": {
    "open": [
      {
        "kind": "fresh"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "kind": "do",
      "verb": "viewport",
      "params": {
        "width": 1280,
        "height": 800
      },
      "intent": "pin viewport"
    },
    {
      "id": "s2",
      "kind": "do",
      "verb": "goto",
      "value": {
        "from": "literal",
        "literal": "http://127.0.0.1:4899/settings"
      },
      "intent": "open /settings"
    },
    {
      "id": "s3",
      "kind": "check",
      "claim": {
        "subject": {
          "element": {
            "raw": {
              "kind": "css",
              "value": "header"
            },
            "reason": "selftest"
          }
        },
        "predicate": "isVisible"
      },
      "intent": "app shell rendered"
    },
    {
      "id": "s9",
      "kind": "check",
      "claim": {
        "subject": {
          "shot": "s3",
          "mask": [
            "[data-qa-volatile]"
          ]
        },
        "predicate": "matches",
        "tolerance": {
          "pixels": 0.02
        }
      },
      "intent": "visual baseline"
    },
    {
      "id": "s10",
      "kind": "check",
      "claim": {
        "subject": {
          "domshot": "s3",
          "skip": [
            "v\\d+\\.\\d+\\.\\d+",
            "StaticText \"[/~]",
            "StaticText \"[A-Za-z]:"
          ]
        },
        "predicate": "matches"
      },
      "intent": "structural baseline (ARIA tree)"
    }
  ]
}
